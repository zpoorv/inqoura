{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "INQOURA_STORE_BUILD": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "INQOURA_STORE_BUILD": "1"
      },
